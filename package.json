{
  "name": "ai-ready-styleguide-generator",
  "version": "1.0.0",
  "description": "Generate AI/Machine-readable Figma style guides from UI screenshots",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "start": "node server/index.js"
  },
  "keywords": [
    "figma",
    "design-system",
    "ai",
    "style-guide",
    "design-tokens"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "sharp": "^0.33.0",
    "openai": "^4.20.1",
    "@anthropic-ai/sdk": "^0.27.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  }
}
